PORT=5000
NODE_ENV=development
# Local mongo (docker compose uses its own); for Atlas use your mongodb+srv:// URI
MONGO_URI=mongodb://localhost:27017/support_agent
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins (only needed if client calls the API cross-origin)
CORS_ORIGIN=http://localhost:5173
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated, tried in order (fallback on 429/5xx/empty reply)
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free
# Low temperature = consistent, knowledge-base-faithful answers. max tokens caps reply length/cost.
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
